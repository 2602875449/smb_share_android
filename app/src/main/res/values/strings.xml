    <!-- Permission Dialogs -->
    <string name="permission_title_storage_download">Storage Permission Required</string>
    <string name="permission_message_storage_download">To download files to your device, the app needs storage permission.\n\nYour files will be saved in the Download folder, and you can view and manage them anytime.</string>
    <string name="permission_title_storage_upload">Storage Permission Required</string>
    <string name="permission_message_storage_upload">To upload files to the SMB server, the app needs permission to read files on your device.\n\nThe app will only read the files you select and will not access other files.</string>
    <string name="permission_title_notification">Notification Permission Required</string>
    <string name="permission_message_notification">To continuously display transfer progress and ensure stable transfer service, the app needs to send notifications.\n\nNotifications are only used to display upload/download status and network change alerts, and will not push ads.</string>
