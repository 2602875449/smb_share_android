    <string name="permission_message_storage_upload_denied">You have denied storage permission and cannot upload files.\n\nTo use the upload feature, please go to settings and manually grant storage permission.</string>
    <string name="permission_message_notification_denied">You have denied notification permission, and the transfer service cannot run continuously in the background.\n\nTo continue receiving upload/download progress and error alerts, please go to settings and manually enable notifications.</string>
